# Input data are archived externally / 原始数据通过外链归档
data/*
!data/README.md
!data/MANIFEST.tsv

# Generated intermediates and render artefacts / 生成的中间文件与渲染产物
result/html/
result/prepared/
result/rds/
result/intermediate/
result/logs/
result/v2/

# Local R state / 本地 R 状态
.Rhistory
.RData
Rplots.pdf
*.tmp-*

# Downloaded server results and generated outputs
server_result/*
!server_result/README.md
!server_result/MANIFEST.tsv
result/
__pycache__/
